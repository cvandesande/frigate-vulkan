PROFILE_NAME=gfx906-vulkan
FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:0.17.2
NCNN_TAG=20260526
VIDEO_GID=44
RENDER_GID=992
NCNN_FP16=0
# RADV maps ncnn's transfer queue to the graphics family, putting load_model()'s
# weight upload on the gfx ring, where it page-faults on Vega 20 if VAAPI
# contexts are being created concurrently. This moves it to SDMA instead:
# verified 4/4 against a repro that failed 2/2. See docs/vulkan-notes.md.
RADV_PERFTEST=transfer_queue
NOTES=Experimental RADV Vulkan/ncnn profile for Vega 20 (Radeon VII, gfx906). RENDER_GID is 992 on Debian 13 trixie, not the 109 Bookworm uses.
