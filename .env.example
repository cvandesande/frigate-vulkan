# Corvette issue #2 (D2): build args for docker/Dockerfile.py313 only, which
# no compose service builds yet (`docker buildx build` directly, see
# docs/vulkan-notes.md). Mirrored here alongside FRIGATE_IMAGE/NCNN_TAG for
# when that wiring happens. CORVETTE_UI_IMAGE must stay digest-pinned
# (INV-4) -- never edit this to a bare tag.
CORVETTE_VERSION=20261104
CORVETTE_UI_IMAGE=docker.io/cvandesande/corvette-ui:20261104@sha256:20dc4a5dcb809465b31526bc1af29764059af92e7b99b1f978b759551debf0a6
