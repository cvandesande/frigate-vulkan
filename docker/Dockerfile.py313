# syntax=docker/dockerfile:1.7
#
# Experimental Python 3.13 / Trixie rebuild of the Vulkan detector image.
#
# Unlike docker/Dockerfile, this does not build FROM Frigate. It uses the
# Frigate image only as a parts donor for the pieces that cannot be rebuilt
# cheaply (the React web UI, the custom nginx, go2rtc, tempio, ffmpeg, the s6
# supervision tree) and reinstalls the Python half on 3.13 with only the
# packages a Vulkan/ncnn deployment loads. See docs/vulkan-notes.md.
#
# Two things make this possible and are load-bearing:
#   * norfair 2.3.0 declares numpy<2.0.0, which would pin Python to 3.12.
#     norfair and filterpy are pure Python, so that pin is metadata only --
#     both run correctly on numpy 2.x. They are installed with --no-deps to
#     bypass the resolver, which means we own that override.
#   * Trixie ships Mesa 25 natively, so the bookworm-backports pinning that
#     docker/Dockerfile needs disappears entirely here.
ARG FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:0.17.2
ARG NCNN_TAG=20260526
ARG PYTHON_IMAGE=python:3.13-slim-trixie

# Corvette issue #2 (D2): the Leptos UI replacement, built and pushed
# separately, consumed here only by digest -- never a floating tag (INV-4).
# CORVETTE_VERSION is the dated tag the digest below was pushed under; it is
# not itself trusted for anything but a human-readable label, since
# CORVETTE_UI_IMAGE's @sha256 is what actually pins the FROM. The default
# here is the real digest recorded in corvette's
# .agents/issue-2/evidence/corvette-ui-digest.txt after the 2026-09-04 push
# (commit 0e1bfcf -- issue #20, monitor mode M1-M5) -- never a placeholder or
# hand-typed value.
ARG CORVETTE_VERSION=20260907
ARG CORVETTE_UI_IMAGE=docker.io/cvandesande/corvette-ui:${CORVETTE_VERSION}@sha256:3025ae0bd96eea9e865a27ee2f185bd79d60ee79af515da35292b54dae002091

FROM ${PYTHON_IMAGE} AS ncnn-builder
ARG NCNN_TAG
COPY docker/scripts/build_ncnn_wheel.sh /usr/local/bin/build_ncnn_wheel.sh
RUN chmod +x /usr/local/bin/build_ncnn_wheel.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential cmake git libvulkan-dev ninja-build pkg-config \
    && /usr/local/bin/build_ncnn_wheel.sh "${NCNN_TAG}"

FROM ${FRIGATE_IMAGE} AS donor

FROM ${CORVETTE_UI_IMAGE} AS corvette-ui

FROM ${PYTHON_IMAGE} AS frigate-vulkan-py313

# Re-enter scope: ARGs declared before the first FROM do not carry into any
# stage automatically, each stage that needs one must redeclare it bare.
ARG CORVETTE_VERSION
ARG CORVETTE_UI_IMAGE

# INV-4: fail the build before anything else happens if CORVETTE_UI_IMAGE is
# not pinned by digest. A bare repo:tag would still pull successfully above
# (docker.io/cvandesande/corvette-ui:20260815 is a real, resolvable tag), so
# the FROM on its own cannot catch this -- only an explicit check can.
COPY docker/scripts/check_corvette_ui_image.py /usr/local/bin/check_corvette_ui_image.py
RUN CORVETTE_UI_IMAGE="${CORVETTE_UI_IMAGE}" python3 /usr/local/bin/check_corvette_ui_image.py

# openssl and yq are called by the s6 nginx/prepare scripts; mountpoint comes
# from util-linux. mesa-vulkan-drivers here is Trixie's own 25.x.
#
# mesa-va-drivers/libva are for ffmpeg video decoding, which is a separate GPU
# path from ncnn's Vulkan compute: without them go2rtc's hardware probe fails,
# auto_detect_hwaccel logs "Did not detect hwaccel" and every camera silently
# falls back to software decode. vainfo backs Frigate's /api/vainfo endpoint.
# Intel's iHD driver is deliberately omitted -- this image targets AMD.
# radeontop backs frigate.util.services.get_amd_gpu_stats; without it every
# stats interval raises FileNotFoundError and the GPU panel stays empty.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates curl jq libgomp1 libvulkan1 mesa-vulkan-drivers \
        libva2 libva-drm2 mesa-va-drivers vainfo \
        openssl radeontop util-linux \
        libcrypt1 libpcre2-8-0 libxml2 liblzma5 zlib1g \
    && rm -rf /var/lib/apt/lists/*

# Frigate's nginx is built on Bookworm and links ICU 72, which Trixie replaced
# with ICU 76. Carrying the two .so files across is cheaper than rebuilding
# nginx with its vod/secure-token modules.
COPY --from=donor /usr/lib/x86_64-linux-gnu/libicuuc.so.72 \
                  /usr/lib/x86_64-linux-gnu/libicudata.so.72 \
                  /usr/lib/x86_64-linux-gnu/

# s6-overlay: /init, the execline command set, and the service definitions.
# All statically linked, so they cross the Bookworm -> Trixie boundary as-is.
COPY --from=donor /init /init
COPY --from=donor /command /command
COPY --from=donor /package /package
COPY --from=donor /etc/s6-overlay /etc/s6-overlay

# Corvette issue #12 (F1): stop go2rtc from starting at all. This deployment's
# Frigate config routes detect/record through go2rtc's own RTSP restream
# (issue #12 RESEARCH-frigate-ingest-boundary.md F-4/F-5), which #12 replaces
# with a Rust-native RTSP-restream server (D-6/D-7) running as a sibling
# container, and go2rtc's live-view role (mse/webrtc) is unused here (F-8/F-9)
# -- so once that replacement ships, nothing in this image should need go2rtc.
#
# Two edges in the donor's s6-rc database name go2rtc, and BOTH must be cut,
# not just the obvious one:
#   - s6-rc.d/frigate/dependencies.d/go2rtc -- the `frigate` service's own
#     declared startup dependency on go2rtc (the one upstream Frigate's own
#     docs/source describe).
#   - s6-rc.d/user/contents.d/go2rtc-pipeline -- go2rtc is ALSO wired directly
#     into the top-level `user` bundle s6-overlay brings up at boot, via the
#     synthetic "-pipeline" bundle s6-overlay generates for every longrun that
#     is a producer-for a log service. This is independent of frigate's own
#     dependency edge above: removing only the `frigate` dependency marker
#     leaves go2rtc-pipeline still listed here, so go2rtc (and its sibling
#     go2rtc-healthcheck, which shares the same log pipeline) still starts as
#     its own top-level target regardless of whether frigate waits on it.
#     Confirmed empirically against the donor image directly (not assumed from
#     source alone): with only the first marker removed, `go2rtc: starting`
#     still appears in the s6-rc boot log; with both removed, neither go2rtc
#     nor go2rtc-healthcheck ever starts, nothing binds :8554, and Frigate
#     still reaches its normal ready state (init_go2rtc, frigate/app.py, is a
#     bare psutil scan for an already-running process -- it never spawns
#     go2rtc itself and does not fail when the scan finds nothing).
#
# Neither the go2rtc service directory itself nor create_config.py's
# invocation inside its `run` script is removed -- with both edges above cut,
# s6-rc never brings the service up, so that script never executes and is
# harmless left in place.
RUN rm -f /etc/s6-overlay/s6-rc.d/frigate/dependencies.d/go2rtc \
          /etc/s6-overlay/s6-rc.d/user/contents.d/go2rtc-pipeline

# Prebuilt components. ffmpeg links nothing but glibc, and glibc 2.36 binaries
# run on 2.41, so only the 7.0 build is carried -- 5.0 is 211MB of fallback
# this deployment never selects.
COPY --from=donor /usr/local/nginx /usr/local/nginx

# Corvette issue #2 (D1): the donor's nginx has no location for the Leptos UI
# bundle, so a missing chunk under /pkg/ silently returns index.html at 200
# instead of a 404, and every chunk is Cache-Control: no-store. Nested inside
# the donor's own `location /`, the same way it already nests /assets/,
# /fonts/ and /locales/. Fails the build if the donor's nginx.conf has drifted
# from the pinned revision -- see the script for the full rationale.
COPY docker/scripts/patch_pkg_location.py /usr/local/bin/patch_pkg_location.py
RUN python3 /usr/local/bin/patch_pkg_location.py

# Corvette issue #12 (N1, resolving OPEN-2): the donor's nginx has no
# /live/hls/ location. D-6 fully replaces go2rtc, including its own
# HLS-adjacent role, so the expanded-view fallback needs a real backend once
# go2rtc is gone -- G3 (corvette-media-bridge's own HLS/LL-HLS packager,
# a sibling container in this pod per K1) is that backend. Must run AFTER
# patch_pkg_location.py: this script's own drift guard checks the md5 of
# nginx.conf with the /pkg/ location already inserted, not the pristine
# donor's -- see the script for the full rationale.
COPY docker/scripts/patch_live_hls_location.py /usr/local/bin/patch_live_hls_location.py
RUN python3 /usr/local/bin/patch_live_hls_location.py

# Corvette issue #12 (N2): D-6 fully replaces go2rtc, not only its live-view
# role, so every location in the donor's nginx.conf that proxies to the
# go2rtc upstream is permanently dead -- five of them, confirmed directly
# against tests/nginx-parity/vendor/nginx.conf (corvette). Four have no
# replacement; the fifth, /live/mse/api/ws, is replaced by a new location
# proxying to G2 (corvette-media-bridge's own fMP4-over-WebSocket packager,
# a sibling container in this pod per K1), since the grid tile's live view
# (corvette's crates/corvette-ui/src/live_view.rs, item U1) depends on that
# replacement existing. Must run AFTER patch_live_hls_location.py: this
# script's own drift guard checks the md5 of nginx.conf with both the /pkg/
# and /live/hls/ locations already inserted, not the pristine donor's -- see
# the script for the full rationale.
COPY docker/scripts/patch_retire_go2rtc_routes.py /usr/local/bin/patch_retire_go2rtc_routes.py
RUN python3 /usr/local/bin/patch_retire_go2rtc_routes.py

# Corvette issue #12 (U2): nginx has no location for U2's vendored
# `@moq/watch`/`hls.js` bundles, so a request for either falls through to the
# donor's SPA fallback (200, wrong content) instead of a real file -- see the
# script for the full rationale. Independent of D1/N1/N2's own insertion
# points; deliberately last, so none of their own drift-guard EXPECTED_MD5
# values need to change to account for it.
COPY docker/scripts/patch_vendor_location.py /usr/local/bin/patch_vendor_location.py
RUN python3 /usr/local/bin/patch_vendor_location.py

COPY --from=donor /usr/local/go2rtc /usr/local/go2rtc
COPY --from=donor /usr/local/tempio /usr/local/tempio
COPY --from=donor /usr/local/ffmpeg /usr/local/ffmpeg
COPY --from=donor /usr/local/bin/yq /usr/local/bin/yq
# sqlite-vec extension, dlopened by frigate/db/sqlitevecq.py at connect time.
# Without it the embeddings DB thread dies on startup with an OperationalError.
COPY --from=donor /usr/local/lib/vec0.so /usr/local/lib/vec0.so
COPY --from=donor /usr/lib/ffmpeg/7.0 /usr/lib/ffmpeg/7.0
COPY --from=donor /opt/frigate /opt/frigate

# Corvette issue #2 (D2): overlay the Leptos UI build into the donor's
# /opt/frigate/web. INV-2 -- this must never delete, move, or replace the
# directory or anything already in it (login.html, /assets/, /fonts/,
# /locales/, robots.txt, notifications-worker.js all keep working); the
# trailing slash on both sides is load-bearing, it makes this a merge into
# the existing directory, not a replacement of it. Only index.html is
# overwritten, by design -- Corvette's shell replaces Frigate's React
# index.html. /site/'s own contents are exactly index.html, pkg/** and
# vendor/** (U2's vendored @moq/watch/hls.js bundles; INV-1 is enforced
# upstream, at publish time, not here).
COPY --from=corvette-ui /site/ /opt/frigate/web/

# Corvette issue #12 (V3): tell the expanded live view where to dial the MoQ
# relay -- CORVETTE_MOQ_RELAY_URL defaults empty (today's behavior: the
# expanded view always uses its HLS fallback), so a build with no
# --build-arg for this is unaffected. See patch_moq_relay_url.py's own doc
# for why this file needs no EXPECTED_MD5 drift guard the way the nginx
# patches above do.
# Matches CORVETTE_UI_IMAGE's own precedent immediately above: this
# Dockerfile's default is this specific deployment's actual value, not a
# generic placeholder, and gets overridden per --build-arg for any other
# deployment. "/anon" mirrors moq_publish.rs's own connect URL shape exactly
# (corvette's G1 evidence log: "relay=https://127.0.0.1:34097/anon"). Set
# once the router owner enabled external UDP/443 forwarding to the
# frigate-moq NodePort -- reachability itself is a real-browser question,
# not independently re-verified from this build host (a plain curl QUIC
# probe from here still times out, most plausibly a NAT-hairpin limitation
# specific to LAN-adjacent clients, not evidence either way about a genuine
# external client). See .agents/issue-12/PLAN-live-view.md's V3 for the full
# reachability history.
ARG CORVETTE_MOQ_RELAY_URL="https://orkcams.opendmz.com/anon"
COPY docker/scripts/patch_moq_relay_url.py /usr/local/bin/patch_moq_relay_url.py
RUN CORVETTE_MOQ_RELAY_URL="${CORVETTE_MOQ_RELAY_URL}" python3 /usr/local/bin/patch_moq_relay_url.py

# labelmap.txt is the default detector labelmap and is read during config
# validation, so it is required even for a model that ships its own. The two
# CPU tflite models are the fallback detector and audio detection, both working
# again via the litert shim, for 8MB. edgetpu_model.tflite and /openvino-model
# are deliberately omitted -- those runtimes are not installed here.
COPY --from=donor /labelmap.txt /audio-labelmap.txt /
COPY --from=donor /cpu_model.tflite /cpu_audio_model.tflite /

RUN ldconfig

# go2rtc's run script writes /tmp/cache/homekit_config.json before frigate.app
# creates /tmp/cache, so the redirect fails with a bare "No such file or
# directory" and HomeKit config cleanup is skipped. Shipping the directory
# fixes the ordering without patching upstream's script. A deployment that
# mounts a fresh tmpfs over /tmp reintroduces it, harmlessly.
RUN mkdir -p /tmp/cache

ENV PATH=/usr/local/go2rtc/bin:/usr/local/tempio/bin:/usr/local/nginx/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV S6_LOGGING_SCRIPT="T 1 n0 s10000000 T"
ENV S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0
ENV DEFAULT_FFMPEG_VERSION=7.0
ENV INCLUDED_FFMPEG_VERSIONS=7.0
ENV TOKENIZERS_PARALLELISM=true
ENV TRANSFORMERS_NO_ADVISORY_WARNINGS=1
ENV OPENCV_FFMPEG_LOGLEVEL=8
ENV PYTHONWARNINGS=ignore:::numpy.core.getlimits

COPY docker/requirements-vulkan.txt /tmp/requirements-vulkan.txt
RUN python3 -m pip install --no-cache-dir 'numpy>=2,<3' -r /tmp/requirements-vulkan.txt \
    && python3 -m pip install --no-cache-dir --no-deps norfair==2.3.0 filterpy==1.4.5 \
    && rm -f /tmp/requirements-vulkan.txt

# Must land after the pip install so it cannot be clobbered by a real wheel.
COPY docker/shims/tflite_runtime /usr/local/lib/python3.13/site-packages/tflite_runtime
RUN python3 -c "from tflite_runtime.interpreter import Interpreter, load_delegate; print('tflite_runtime shim -> ai-edge-litert OK')"

RUN --mount=type=bind,from=ncnn-builder,source=/wheels,target=/wheels \
    python3 -m pip install --no-cache-dir --no-deps /wheels/*.whl \
    && python3 -c "import ncnn; assert hasattr(ncnn, 'get_gpu_count'); print('ncnn Vulkan wheel OK')"

COPY docker/scripts/patch_untracked_shm.py /usr/local/bin/patch_untracked_shm.py
RUN python3 /usr/local/bin/patch_untracked_shm.py

COPY docker/frigate/ncnn.py /opt/frigate/frigate/detectors/plugins/ncnn.py
RUN cd /opt/frigate \
    && python3 -c "from frigate.detectors.detector_types import api_types; assert 'ncnn' in api_types; print('detectors:', sorted(api_types))"

EXPOSE 5000 8554 8555/tcp 8555/udp
WORKDIR /opt/frigate/
HEALTHCHECK --start-period=5m --start-interval=5s --interval=15s --timeout=5s --retries=3 \
    CMD test -f /dev/shm/.frigate-is-stopping && exit 0; curl --fail --silent --show-error http://127.0.0.1:5000/api/version || exit 1
ENTRYPOINT ["/init"]
